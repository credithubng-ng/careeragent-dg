{
  "name": "Job",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "candidate_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "recruitment_agency": {
      "type": "string"
    },
    "job_source_id": {
      "type": "string"
    },
    "job_source_name": {
      "type": "string"
    },
    "original_job_url": {
      "type": "string"
    },
    "canonical_job_url": {
      "type": "string"
    },
    "email_source_url": {
      "type": "string"
    },
    "final_redirected_url": {
      "type": "string"
    },
    "url_resolution_status": {
      "type": "string",
      "enum": [
        "Resolved",
        "Restricted",
        "Failed",
        "Not Attempted",
        "Skipped"
      ],
      "default": "Not Attempted"
    },
    "job_reference": {
      "type": "string"
    },
    "date_discovered": {
      "type": "string"
    },
    "date_posted": {
      "type": "string"
    },
    "closing_date": {
      "type": "string"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "Permanent",
        "Contract",
        "Interim",
        "Fixed Term",
        "Part-time"
      ]
    },
    "contract_length": {
      "type": "string"
    },
    "inside_or_outside_ir35": {
      "type": "string",
      "enum": [
        "Inside IR35",
        "Outside IR35",
        "Not Stated"
      ]
    },
    "location": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "work_arrangement": {
      "type": "string",
      "enum": [
        "Remote",
        "Hybrid",
        "Office",
        "Unspecified"
      ]
    },
    "salary_min": {
      "type": "number"
    },
    "salary_max": {
      "type": "number"
    },
    "salary_description": {
      "type": "string"
    },
    "salary_period": {
      "type": "string",
      "enum": [
        "annual",
        "daily",
        "hourly",
        "monthly",
        "not_stated"
      ]
    },
    "salary_text": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "GBP"
    },
    "role_summary": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "responsibilities": {
      "type": "string"
    },
    "essential_requirements": {
      "type": "string"
    },
    "desirable_requirements": {
      "type": "string"
    },
    "required_skills": {
      "type": "string"
    },
    "required_experience": {
      "type": "string"
    },
    "required_years_experience": {
      "type": "number"
    },
    "required_qualifications": {
      "type": "string"
    },
    "required_certifications": {
      "type": "string"
    },
    "required_technologies": {
      "type": "string"
    },
    "required_sector_experience": {
      "type": "string"
    },
    "seniority": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "right_to_work_requirements": {
      "type": "string"
    },
    "language_requirements": {
      "type": "string"
    },
    "security_clearance_requirement": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "recruiter_linkedin_url": {
      "type": "string"
    },
    "job_status": {
      "type": "string",
      "enum": [
        "New",
        "Reviewing",
        "High Priority",
        "Apply",
        "Maybe",
        "Skip",
        "Preparing Application",
        "Applied",
        "Interview",
        "Offer",
        "Rejected",
        "Withdrawn",
        "Expired"
      ],
      "default": "New"
    },
    "duplicate_job_reference": {
      "type": "string"
    },
    "expired_status": {
      "type": "boolean",
      "default": false
    },
    "candidate_notes": {
      "type": "string"
    },
    "match_score": {
      "type": "number"
    },
    "recommendation": {
      "type": "string"
    },
    "vacancy_confirmed_active": {
      "type": "boolean",
      "default": false
    },
    "vacancy_confirmed_date": {
      "type": "string"
    },
    "import_method": {
      "type": "string",
      "enum": [
        "URL",
        "Paste",
        "PDF",
        "Manual",
        "Email"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "Success",
        "Partial",
        "Failed",
        "Manual"
      ]
    },
    "extraction_method": {
      "type": "string"
    },
    "extraction_confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "job_content_status": {
      "type": "string",
      "enum": [
        "Complete",
        "Partial",
        "Restricted Source",
        "Needs Manual Review",
        "Failed"
      ],
      "default": "Partial"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Processing",
        "Completed",
        "Partial",
        "Restricted",
        "Failed"
      ],
      "default": "Pending"
    },
    "enrichment_method": {
      "type": "string",
      "enum": [
        "Structured JobPosting",
        "Website Adapter",
        "Generic Page Extraction",
        "Email Snippet",
        "Manual Paste",
        "PDF",
        "AI Isolation"
      ]
    },
    "enrichment_attempted_at": {
      "type": "string"
    },
    "enrichment_completed_at": {
      "type": "string"
    },
    "enrichment_error": {
      "type": "string"
    },
    "ignored_section_count": {
      "type": "number",
      "default": 0
    },
    "source_content_length": {
      "type": "number",
      "default": 0
    },
    "cleaned_content_length": {
      "type": "number",
      "default": 0
    },
    "content_hash": {
      "type": "string"
    },
    "last_match_date": {
      "type": "string"
    },
    "discovered_from_email": {
      "type": "boolean",
      "default": false
    },
    "email_source": {
      "type": "string"
    },
    "email_message_id": {
      "type": "string"
    },
    "email_alert_date": {
      "type": "string"
    },
    "source_job_id": {
      "type": "string"
    },
    "additional_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_discovered_date": {
      "type": "string"
    },
    "last_seen_date": {
      "type": "string"
    },
    "relevance_tier": {
      "type": "string",
      "enum": [
        "Relevant",
        "Possibly Relevant",
        "Unlikely Relevant"
      ]
    },
    "email_import_status": {
      "type": "string",
      "enum": [
        "Complete",
        "Partial",
        "URL Restricted",
        "Needs Review",
        "Failed"
      ]
    }
  },
  "required": [
    "job_title"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}