{
  "name": "DiscoveryRule",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "candidate_id": {
      "type": "string"
    },
    "rule_name": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "Include",
        "Exclude",
        "Boost",
        "Reduce Priority",
        "Require Review",
        "Hard Stop"
      ],
      "default": "Include"
    },
    "condition": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "default": 5
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "rule_name"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}