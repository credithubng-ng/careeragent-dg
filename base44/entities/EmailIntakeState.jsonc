{
  "name": "EmailIntakeState",
  "type": "object",
  "properties": {
    "owner_email": { "type": "string", "format": "email" },
    "candidate_id": { "type": "string" },
    "last_checked_at": { "type": "string" },
    "last_scan_status": { "type": "string" },
    "last_emails_scanned": { "type": "number", "default": 0 },
    "total_emails_processed": { "type": "number", "default": 0 },
    "total_jobs_imported": { "type": "number", "default": 0 },
    "total_duplicates_skipped": { "type": "number", "default": 0 },
    "total_failed_emails": { "type": "number", "default": 0 },
    "total_unknown_reviewed": { "type": "number", "default": 0 }
  },
  "required": ["owner_email"],
  "rls": {
    "create": { "data.owner_email": "{{user.email}}" },
    "read": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "data.owner_email": "{{user.email}}" }
  }
}
