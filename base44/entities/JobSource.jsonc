{
  "name": "JobSource",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "candidate_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "Job Board",
        "Recruitment Agency",
        "Employer Career Site",
        "Email Alert",
        "Referral",
        "LinkedIn Contact",
        "Manual Entry",
        "API Feed",
        "Other"
      ]
    },
    "website": {
      "type": "string"
    },
    "active_status": {
      "type": "boolean",
      "default": true
    },
    "reliability_rating": {
      "type": "number"
    },
    "jobs_found": {
      "type": "number"
    },
    "applications": {
      "type": "number"
    },
    "interviews": {
      "type": "number"
    },
    "offers": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "source_name"
  ],
  "rls": {
    "create": { "data.owner_email": "{{user.email}}" },
    "read": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "data.owner_email": "{{user.email}}" }
  }
}
