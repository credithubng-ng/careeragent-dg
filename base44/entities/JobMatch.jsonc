{
  "name": "JobMatch",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "matching_engine_version": {
      "type": "number",
      "default": 2
    },
    "total_score": {
      "type": "number"
    },
    "verified_fit": {
      "type": "number"
    },
    "assessment_coverage": {
      "type": "number"
    },
    "assessment_status": {
      "type": "string",
      "enum": [
        "Preliminary",
        "Final",
        "Needs Review",
        "Needs Reanalysis",
        "Restricted Source",
        "Failed"
      ],
      "default": "Preliminary"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "Excellent Match",
        "Good Match",
        "Worth Reviewing",
        "Possible Match",
        "Poor Match",
        "Do Not Apply",
        "Reject"
      ]
    },
    "confidence": {
      "type": "string"
    },
    "strong_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partial_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transferable_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_stops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_cv": {
      "type": "string"
    },
    "application_priority": {
      "type": "string"
    },
    "suggested_deadline": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": true
    },
    "category_analysis": {
      "type": "object",
      "additionalProperties": true
    },
    "content_hash": {
      "type": "string"
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}