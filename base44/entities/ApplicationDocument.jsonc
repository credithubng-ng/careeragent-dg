{
  "name": "ApplicationDocument",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Tailored Profile",
        "CV Improvement",
        "Cover Letter",
        "Supporting Statement",
        "Recruiter Message",
        "Application Question"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "source_cv_id": {
      "type": "string"
    },
    "source_job_match_id": {
      "type": "string"
    },
    "evidence_quotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grounding_status": {
      "type": "string",
      "enum": [
        "Verified",
        "Candidate Edited",
        "Unverified"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "date_generated": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Not Approved",
        "Approved"
      ],
      "default": "Draft"
    },
    "question_text": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "document_type"
  ],
  "rls": {
    "create": { "data.owner_email": "{{user.email}}" },
    "read": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "$or": [{ "data.owner_email": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "delete": { "data.owner_email": "{{user.email}}" }
  }
}
