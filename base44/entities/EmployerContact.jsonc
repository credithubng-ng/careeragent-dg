{
  "name": "EmployerContact",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "candidate_id": {
      "type": "string"
    },
    "employer_id": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telephone": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "Recruiter",
        "Hiring Manager",
        "Other"
      ],
      "default": "Recruiter"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}