{
  "name": "Gmail Intake",
  "description": "Processes new job-alert emails in real-time as they arrive in the connected user's Gmail, using the App User connector",
  "trigger": {
    "config": {
      "trigger_type": "connector",
      "integration_type": "gmail",
      "events": [
        "mailbox"
      ]
    },
    "condition": "${ .trigger.data.has_new_messages == true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gmail_intake",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_emails": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processGmailAlerts",
            "args": {
              "mode": "webhook",
              "message_ids": "${ .trigger.data.new_message_ids }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process new Gmail job alerts",
            "description": "Extract vacancies from new emails in real time"
          }
        }
      }
    ]
  }
}